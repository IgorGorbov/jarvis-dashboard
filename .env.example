# Панель читает этот файл сама — переименуйте в .env и поправьте под себя.
# Всё необязательно: без файла берутся значения из README.

# Каталог артефактов Jarvis. По умолчанию — ../agents/artifacts/jarvis
# рядом с панелью. Панель читает его с диска, поэтому каталог должен быть
# доступен локально: либо панель стоит на машине агента, либо каталог смонтирован.
JARVIS_ARTIFACTS=/путь/до/agents/artifacts/jarvis

# Адрес агента для кнопок «Запустить задачу», «Ответить», «Отменить».
JARVIS_A2A=http://localhost:4000

# Порт самой панели.
PORT=4100

# Схемы агента — нужны только двум проверкам: сверке идентификаторов решений и
# счётчику покрытия. Без них обе пропускаются, панель работает как обычно.
JARVIS_SCHEMAS=/путь/до/agents/src/agents/jarvis/internal/schemas.ts
